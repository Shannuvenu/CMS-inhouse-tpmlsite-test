<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Form Integration</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        form {
            display: flex;
            flex-direction: column;
        }
        label, input, button {
            margin-bottom: 10px;
        }
        button {
            align-self: flex-start;
        }
        #confirmationMessage {
            display: none;
            background-color: #dff0d8;
            border: 1px solid #d6e9c6;
            color: #3c763d;
            padding: 15px;
            margin-top: 20px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <h1>Contact Information Form</h1>
    <form id="googleForm">
        <label for="entry.610207400">Name:</label>
        <input type="text" id="entry.610207400" name="entry.610207400" required>

        <label for="entry.2049532706">Email:</label>
        <input type="email" id="entry.2049532706" name="entry.2049532706">

        <label for="entry.1852131401">Phone Number:</label>
        <input type="tel" id="entry.1852131401" name="entry.1852131401">

        <button type="submit">Submit</button>
    </form>
    <div id="confirmationMessage"></div>

    <script>
        document.getElementById('googleForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const url = 'https://docs.google.com/forms/d/e/1FAIpQLScu9Vg9IU6L0APczx_i5qrxjBhPPlP8NvGA7nnVD4t24g9c6g/formResponse';

            const xhr = new XMLHttpRequest();
            xhr.open('POST', url, true);
            xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');

            xhr.onreadystatechange = function() {
                if (xhr.readyState === XMLHttpRequest.DONE) {
                    if (xhr.status === 0 || xhr.status === 200) {
                        document.getElementById('confirmationMessage').style.display = 'block';
                        document.getElementById('confirmationMessage').innerHTML = 'Thank you for your submission!';
                        document.getElementById('googleForm').reset();
                    } else {
                        console.error('Error:', xhr.status, xhr.statusText);
                        document.getElementById('confirmationMessage').style.display = 'block';
                        document.getElementById('confirmationMessage').innerHTML = 'An error occurred. Please try again later. Error: ' + xhr.status;
                    }
                }
            };

            xhr.onerror = function() {
                console.error('Request error');
                document.getElementById('confirmationMessage').style.display = 'block';
                document.getElementById('confirmationMessage').innerHTML = 'An error occurred. Please try again later.';
            };

            xhr.send(new URLSearchParams(formData));
        });
    </script>
</body>
</html>
